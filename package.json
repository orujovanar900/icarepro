{
  "name": "icare-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:migrate": "turbo run db:migrate --filter=@icare/database",
    "db:seed": "turbo run db:seed --filter=@icare/database",
    "db:studio": "turbo run db:studio --filter=@icare/database"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "bcrypt",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}