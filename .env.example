# Database (PostgreSQL via Supabase or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/icare_db"

# Auth — REQUIRED, app will exit(1) if not set
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
COOKIE_SECRET="your-cookie-secret-change-in-production"

# Supabase (for file storage & auth)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# AI — server-side only (NO VITE_ prefix)
ANTHROPIC_API_KEY="sk-ant-..."

# Seed passwords — used by prisma/seed.ts only
SEED_OWNER_PASSWORD="your-secure-owner-password"
SEED_STAFF_PASSWORD="your-secure-staff-password"
